<?xml version="1.0" encoding="utf-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT1H30M0S" minBufferTime="PT1.5S">
  <Period>
    <AdaptationSet mimeType="video/mp4" codecs="avc1.640028" width="1920" height="1080" frameRate="24">
      <Representation id="1080p" bandwidth="15000000">
        <SegmentTemplate media="segments/$Number$.m4s" initialization="segments/init.mp4" duration="4" startNumber="0"/>
      </Representation>
    </AdaptationSet>
    <AdaptationSet mimeType="audio/mp4" codecs="mp4a.40.2" lang="en">
      <Representation id="stereo" bandwidth="256000" audioSamplingRate="48000">
        <SegmentTemplate media="audio/$Number$.m4s" initialization="audio/init.mp4" duration="4" startNumber="0"/>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
